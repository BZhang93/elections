generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PositionLevel {
  state_executive
  state_legislature
  us_house
  us_senate
  local
}

enum Party {
  Democratic
  Republican
  Independent
  Green
  Libertarian
  Other
}

enum CandidateStatus {
  active
  withdrawn
  disqualified
}

enum SourceType {
  ballotpedia
  ontheissues
  legiscan
  congress_gov
  leginfo_ca_gov
  campaign_site
  news
  other
}

enum VoteType {
  yes
  no
  abstain
  sponsored
  co_sponsored @map("co-sponsored")
}

enum AiJobStatus {
  pending
  done
  failed
}

enum SourceStatus {
  active
  disabled
  archived
}

enum TopicStance {
  a
  b
  none
}

enum TopicSide {
  a
  b
}

enum ItemDirection {
  increase
  decrease
}

enum FundraisingSourceType {
  campaign_total
  independent_expenditure
  pac
  individual
  corporation
  party
  self
  other
}

enum VotingSourceSystem {
  legiscan
  congress_gov
  leginfo_ca_gov
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String?  @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  topicPriorities    UserTopicPriority[]
  stanceRatings      UserStanceRating[]
  freetextInputs     UserFreetextInput[]
  alignmentCache     CandidateAlignmentCache[]

  @@map("users")
}

model Topic {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String  @unique
  label       String
  description String?
  sideALabel  String  @map("side_a_label")
  sideBLabel  String  @map("side_b_label")

  candidateTopics        CandidateTopic[]
  candidateStats         CandidateStat[]
  platformItemTopics     PlatformItemTopic[]
  policyItemTopics       PolicyItemTopic[]
  votingHistoryItemTopics VotingHistoryItemTopic[]
  topicPriorities        UserTopicPriority[]

  @@map("topics")
}

model Position {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String        @unique
  title                String
  level                PositionLevel
  jurisdiction         String?
  electionDate         DateTime?     @map("election_date") @db.Date
  electionCycle        String?       @map("election_cycle")
  incumbentCandidateId String?       @map("incumbent_candidate_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  candidates Candidate[] @relation("PositionCandidates")

  @@map("positions")
}

model Candidate {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  positionId           String          @map("position_id") @db.Uuid
  fullName             String          @map("full_name")
  party                Party
  isIncumbent          Boolean         @default(false) @map("is_incumbent")
  currentPositionTitle String?         @map("current_position_title")
  photoUrl             String?         @map("photo_url")
  campaignSiteUrl      String?         @map("campaign_site_url")
  aiSummary            String?         @map("ai_summary")
  aiSummaryGeneratedAt DateTime?       @map("ai_summary_generated_at")
  aiSummarySourceIds   String[]        @map("ai_summary_source_ids") @db.Uuid
  historyText          String?         @map("history_text")
  status               CandidateStatus @default(active)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at")

  position           Position              @relation("PositionCandidates", fields: [positionId], references: [id], onDelete: Cascade)
  candidateTopics     CandidateTopic[]
  fundraisingSources  FundraisingSource[]
  stats               CandidateStat[]
  aiJobs              AiJob[]
  platformItems       PlatformItem[]
  policyItems         PolicyItem[]
  votingHistoryItems  VotingHistoryItem[]
  alignmentCache      CandidateAlignmentCache[]

  @@unique([positionId, fullName])
  @@map("candidates")
}

model AiJob {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String      @map("candidate_id") @db.Uuid
  kind        String
  status      AiJobStatus @default(pending)
  output      Json?
  error       String?
  requestedAt DateTime    @default(now()) @map("requested_at")
  completedAt DateTime?   @map("completed_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("ai_jobs")
}

model Source {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String       @unique
  status    SourceStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("sources")
}

model CandidateStat {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  topicId     String?  @map("topic_id") @db.Uuid
  summary     String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  candidate Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic     Topic?                  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  citations CandidateStatCitation[]

  @@map("candidate_stats")
}

model CandidateStatCitation {
  candidateStatId String @map("candidate_stat_id") @db.Uuid
  citationId      String @map("citation_id") @db.Uuid

  candidateStat CandidateStat @relation(fields: [candidateStatId], references: [id], onDelete: Cascade)
  citation      Citation      @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([candidateStatId, citationId])
  @@map("candidate_stat_citations")
}

model FundraisingSource {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String               @map("candidate_id") @db.Uuid
  sourceName  String               @map("source_name")
  sourceType  FundraisingSourceType @map("source_type")
  amount      Decimal              @db.Decimal(14, 2)
  cycle       String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at")

  candidate Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  citations FundraisingSourceCitation[]

  @@map("fundraising_sources")
}

model FundraisingSourceCitation {
  fundraisingSourceId String @map("fundraising_source_id") @db.Uuid
  citationId          String @map("citation_id") @db.Uuid

  fundraisingSource FundraisingSource @relation(fields: [fundraisingSourceId], references: [id], onDelete: Cascade)
  citation          Citation          @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([fundraisingSourceId, citationId])
  @@map("fundraising_source_citations")
}

model CandidateTopic {
  candidateId String @map("candidate_id") @db.Uuid
  topicId     String @map("topic_id") @db.Uuid

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([candidateId, topicId])
  @@map("candidate_topics")
}

model Citation {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url           String
  sourceType    SourceType @map("source_type")
  title         String?
  publisher     String?
  publishedDate DateTime?  @map("published_date") @db.Date
  accessedAt    DateTime   @default(now()) @map("accessed_at")
  rawExcerpt    String?    @map("raw_excerpt")

  platformItemCitations      PlatformItemCitation[]
  fundraisingSourceCitations FundraisingSourceCitation[]
  statCitations              CandidateStatCitation[]
  policyItemCitations        PolicyItemCitation[]
  votingHistoryItemCitations VotingHistoryItemCitation[]

  @@unique([url, rawExcerpt])
  @@map("citations")
}

model PlatformItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId   String   @map("candidate_id") @db.Uuid
  text          String
  stanceSummary String?  @map("stance_summary")
  direction     ItemDirection?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  candidate Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topics    PlatformItemTopic[]
  citations PlatformItemCitation[]
  ratings   UserStanceRating[]

  @@map("platform_items")
}

model PlatformItemTopic {
  platformItemId String @map("platform_item_id") @db.Uuid
  topicId         String @map("topic_id") @db.Uuid
  side        TopicSide?

  platformItem PlatformItem @relation(fields: [platformItemId], references: [id], onDelete: Cascade)
  topic        Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([platformItemId, topicId])
  @@map("platform_item_topics")
}

model PlatformItemCitation {
  platformItemId String @map("platform_item_id") @db.Uuid
  citationId      String @map("citation_id") @db.Uuid

  platformItem PlatformItem @relation(fields: [platformItemId], references: [id], onDelete: Cascade)
  citation     Citation     @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([platformItemId, citationId])
  @@map("platform_item_citations")
}

model PolicyItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId   String    @map("candidate_id") @db.Uuid
  actionText    String    @map("action_text")
  effectText    String?   @map("effect_text")
  stanceSummary String?   @map("stance_summary")
  direction     ItemDirection?
  date          DateTime? @db.Date
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  candidate Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topics    PolicyItemTopic[]
  citations PolicyItemCitation[]
  ratings   UserStanceRating[]

  @@map("policy_items")
}

model PolicyItemTopic {
  policyItemId String @map("policy_item_id") @db.Uuid
  topicId      String @map("topic_id") @db.Uuid
  side        TopicSide?

  policyItem PolicyItem @relation(fields: [policyItemId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([policyItemId, topicId])
  @@map("policy_item_topics")
}

model PolicyItemCitation {
  policyItemId String @map("policy_item_id") @db.Uuid
  citationId   String @map("citation_id") @db.Uuid

  policyItem PolicyItem @relation(fields: [policyItemId], references: [id], onDelete: Cascade)
  citation   Citation   @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([policyItemId, citationId])
  @@map("policy_item_citations")
}

model VotingHistoryItem {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId      String              @map("candidate_id") @db.Uuid
  billIdentifier   String?             @map("bill_identifier")
  billTitle        String              @map("bill_title")
  vote             VoteType?
  summary          String?
  date             DateTime?           @db.Date
  stanceSummary    String?             @map("stance_summary")
  direction        ItemDirection?
  sourceSystem     VotingSourceSystem? @map("source_system")
  sourceExternalId String?             @map("source_external_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")

  candidate Candidate                    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topics    VotingHistoryItemTopic[]
  citations VotingHistoryItemCitation[]
  ratings   UserStanceRating[]

  @@unique([candidateId, sourceSystem, sourceExternalId])
  @@map("voting_history_items")
}

model VotingHistoryItemTopic {
  votingHistoryItemId String @map("voting_history_item_id") @db.Uuid
  topicId              String @map("topic_id") @db.Uuid
  side        TopicSide?

  votingHistoryItem VotingHistoryItem @relation(fields: [votingHistoryItemId], references: [id], onDelete: Cascade)
  topic             Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([votingHistoryItemId, topicId])
  @@map("voting_history_item_topics")
}

model VotingHistoryItemCitation {
  votingHistoryItemId String @map("voting_history_item_id") @db.Uuid
  citationId           String @map("citation_id") @db.Uuid

  votingHistoryItem VotingHistoryItem @relation(fields: [votingHistoryItemId], references: [id], onDelete: Cascade)
  citation          Citation          @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([votingHistoryItemId, citationId])
  @@map("voting_history_item_citations")
}

model UserTopicPriority {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  topicId        String      @map("topic_id") @db.Uuid
  rank           Int         @map("rank")
  stance         TopicStance @default(none)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topic_priorities")
}

model UserStanceRating {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  platformItemId      String?   @map("platform_item_id") @db.Uuid
  policyItemId        String?   @map("policy_item_id") @db.Uuid
  votingHistoryItemId String?   @map("voting_history_item_id") @db.Uuid
  agreementScore      Int       @map("agreement_score")
  importanceScore     Int?      @map("importance_score")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformItem      PlatformItem?      @relation(fields: [platformItemId], references: [id], onDelete: Cascade)
  policyItem        PolicyItem?        @relation(fields: [policyItemId], references: [id], onDelete: Cascade)
  votingHistoryItem VotingHistoryItem? @relation(fields: [votingHistoryItemId], references: [id], onDelete: Cascade)

  @@unique([userId, platformItemId])
  @@unique([userId, policyItemId])
  @@unique([userId, votingHistoryItemId])
  @@map("user_stance_ratings")
}

model UserFreetextInput {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  content            String
  extractedTopicIds  String[] @map("extracted_topic_ids") @db.Uuid
  extractedKeywords  String[] @map("extracted_keywords")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_freetext_inputs")
}

model CandidateAlignmentCache {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  score       Decimal  @db.Decimal(5, 2)
  computedAt  DateTime @default(now()) @map("computed_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([userId, candidateId])
  @@map("candidate_alignment_cache")
}

model IngestionRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  positionId   String?   @map("position_id") @db.Uuid
  sourceType   String?   @map("source_type")
  status       String
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  logSummary   String?   @map("log_summary")

  @@map("ingestion_runs")
}
