# Supabase Postgres connection strings (pooled for app runtime, direct for migrate/seed).
DATABASE_URL=
DIRECT_URL=

# Supabase client (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# v1 has no login UI; every request is treated as this seeded user.
DEFAULT_USER_ID=

# Ingestion pipeline (optional, only needed for ingestion/ package)
ANTHROPIC_API_KEY=
LEGISCAN_API_KEY=
CONGRESS_GOV_API_KEY=
NEWS_SEARCH_API_KEY=
